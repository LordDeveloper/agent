# musl binary for Alpine Linux and other musl-based distros.
# Build with: docker buildx build -f Dockerfile.musl --platform linux/amd64|linux/arm64 --target export ...
FROM python:3.12-alpine AS build

WORKDIR /src
RUN apk add --no-cache binutils gcc musl-dev libffi-dev openssl-dev

COPY pyproject.toml requirements.txt ./
COPY src ./src
COPY agent.spec ./

RUN pip install --no-cache-dir -r requirements.txt pyinstaller \
    && pip install --no-cache-dir -e . \
    && pyinstaller --clean --noconfirm agent.spec

FROM scratch AS export
COPY --from=build /src/dist/agent /agent
