# Flat env keys — no AGENT_ / nested prefixes.

LISTEN=0.0.0.0:8443
AUTH_TOKEN=change-me
# AUTH_USERNAME=admin
# AUTH_PASSWORD=secret

DATA_DIR=/var/lib/agent
# DB_PATH=/var/lib/agent/agent.db
# LOG_FILE=/var/lib/agent/agent.log
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=5000000
# LOG_BACKUP_COUNT=5

# Comma-separated: xray | wireguard | amnezia
ENABLED_CORES=xray,wireguard,amnezia

# Customized Xray-core HTTP API (binary from LordDeveloper/xray releases)
XRAY_API_BASE=http://127.0.0.1:8080
XRAY_USERNAME=admin
XRAY_PASSWORD=strong-password
XRAY_BINARY=/usr/local/bin/xray
XRAY_CONFIG=/usr/local/etc/xray/config.json
# XRAY_GITHUB_REPO=LordDeveloper/xray
# XRAY_GITHUB_ASSET=xray-linux-gnu-amd64
# # leave empty to auto-detect: xray-linux-{gnu|musl}-{amd64|arm64}

WIREGUARD_CONFIG_DIR=/etc/wireguard
AMNEZIA_CONFIG_DIR=/etc/amneziawg

# Self-update / private GitHub releases
# Create a classic PAT with `repo`, or a fine-grained PAT:
#   Repository access: LordDeveloper/agent, LordDeveloper/xray
#   Permissions: Contents = Read-only (covers release assets)
# AGENT_GITHUB_REPO=LordDeveloper/agent
# AGENT_GITHUB_ASSET=agent-linux-gnu-amd64
# # leave empty to auto-detect: agent-linux-{gnu|musl}-{amd64|arm64}
# GITHUB_TOKEN=ghp_xxxxxxxx
# # aliases also accepted: GH_TOKEN, AGENT_GITHUB_TOKEN
