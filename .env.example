# Flat env keys — no AGENT_ / nested prefixes.
# Xray binary is installed manually for now; GitHub release download comes later.

LISTEN=0.0.0.0:8443
AUTH_TOKEN=change-me
# AUTH_USERNAME=admin
# AUTH_PASSWORD=secret

DATA_DIR=/var/lib/agent
# DB_PATH=/var/lib/agent/agent.db

# Comma-separated: xray | wireguard | amnezia
ENABLED_CORES=xray,wireguard,amnezia

# Customized Xray-core HTTP API
XRAY_API_BASE=http://127.0.0.1:8080
XRAY_USERNAME=admin
XRAY_PASSWORD=strong-password
XRAY_BINARY=/usr/local/bin/xray

WIREGUARD_CONFIG_DIR=/etc/wireguard
AMNEZIA_CONFIG_DIR=/etc/amneziawg
